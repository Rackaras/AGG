<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground layer: the three AGG leaves.
  Everything stays inside the 66dp safe zone (centre 54,54) so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem -->
    <path
        android:pathData="M54,72 L54,80"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />

    <!-- Left leaf -->
    <group
        android:pivotX="54"
        android:pivotY="74"
        android:rotation="-42"
        android:scaleX="0.85"
        android:scaleY="0.85">
        <path
            android:fillColor="#FFE8F7EE"
            android:pathData="M54,74 C44,64 42,44 54,30 C66,44 64,64 54,74 Z" />
        <path
            android:pathData="M54,70 L54,40"
            android:strokeWidth="1.8"
            android:strokeColor="#FF1E8E4E"
            android:strokeLineCap="round" />
    </group>

    <!-- Right leaf -->
    <group
        android:pivotX="54"
        android:pivotY="74"
        android:rotation="42"
        android:scaleX="0.85"
        android:scaleY="0.85">
        <path
            android:fillColor="#FFE8F7EE"
            android:pathData="M54,74 C44,64 42,44 54,30 C66,44 64,64 54,74 Z" />
        <path
            android:pathData="M54,70 L54,40"
            android:strokeWidth="1.8"
            android:strokeColor="#FF1E8E4E"
            android:strokeLineCap="round" />
    </group>

    <!-- Centre leaf (drawn last, on top) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,74 C44,64 42,44 54,30 C66,44 64,64 54,74 Z" />
    <path
        android:pathData="M54,70 L54,38"
        android:strokeWidth="1.8"
        android:strokeColor="#FF1E8E4E"
        android:strokeLineCap="round" />
</vector>
