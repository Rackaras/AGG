<?xml version="1.0" encoding="utf-8"?>
<!--
  The AGG mark for the dashboard header, following the prototype: three wide, fully rounded leaves
  fanning from a short stem, each a different green with a white vein, and no tile behind them.
  Each leaf is an ellipse arc pair, so neither end has a pointed tip.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="34dp"
    android:height="40dp"
    android:viewportWidth="36"
    android:viewportHeight="44">

    <!-- Stem -->
    <path
        android:pathData="M18,37 L18,42"
        android:strokeWidth="3"
        android:strokeColor="#FF2E7D32"
        android:strokeLineCap="round" />

    <!-- Left leaf -->
    <group
        android:pivotX="18"
        android:pivotY="38"
        android:rotation="-40">
        <path
            android:fillColor="#FF4CAF50"
            android:pathData="M18,12 A8.5,13 0 1,0 18,38 A8.5,13 0 1,0 18,12 Z" />
        <path
            android:pathData="M18,34 L18,17"
            android:strokeWidth="1.5"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
    </group>

    <!-- Right leaf -->
    <group
        android:pivotX="18"
        android:pivotY="38"
        android:rotation="40">
        <path
            android:fillColor="#FF2E7D32"
            android:pathData="M18,12 A8.5,13 0 1,0 18,38 A8.5,13 0 1,0 18,12 Z" />
        <path
            android:pathData="M18,34 L18,17"
            android:strokeWidth="1.5"
            android:strokeColor="#FFFFFFFF"
            android:strokeLineCap="round" />
    </group>

    <!-- Centre leaf, drawn last so it sits in front. -->
    <path
        android:fillColor="#FF7CC47F"
        android:pathData="M18,10 A9,14 0 1,0 18,38 A9,14 0 1,0 18,10 Z" />
    <path
        android:pathData="M18,34 L18,15"
        android:strokeWidth="1.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeLineCap="round" />
</vector>
